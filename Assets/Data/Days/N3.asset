  visits:
  - customer: {fileID: 11400000, guid: f3cb2fa764fb435a9453a16dbccbafb6, type: 2}
    entrance: "Chu\u00f4ng c\u1eeda reo. Perrin b\u01b0\u1edbc v\u00e0o, x\u00e1ch hai c\u00e1i gi\u1ecf r\u1ed7ng, tr\u00e1n l\u1ea5m t\u1ea5m m\u1ed3 h\u00f4i."
    entranceVariants: []
    greeting: "C\u1eadu Tomas, h\u00f4m nay cho t\u00f4i th\u1eadt nhi\u1ec1u rau nh\u00e9. Nh\u00e0 t\u00f4i s\u1eafp c\u00f3 kh\u00e1ch."
    greetingVariants: []
    askCost: 0
    sellPrice: 10
    discountPrice: 6
    sellQuantity: -1
    discountQuantity: -1
    discountActionLabel: ""
    pressSuspicion: 1
    sell:
      tomas: "B\u00e1c l\u1ea5y bao nhi\u00eau c\u0169ng c\u00f3 \u1ea1."
      reply: "Th\u1ebf th\u00ec t\u00f4i l\u1ea5y h\u1ebft ch\u1ed7 c\u00e0 r\u1ed1t n\u00e0y. \u00d4ng ch\u1ee7 d\u1eb7n t\u1eeb h\u00f4m nay b\u1ebfp ph\u1ea3i chu\u1ea9n b\u1ecb r\u1ed3i."
      replyVariants: []
    discount:
      tomas: "B\u00e1c mua nhi\u1ec1u, ch\u00e1u b\u1edbt cho b\u00e1c."
      reply: "C\u1ea3m \u01a1n c\u1eadu. M\u1ea5y h\u00f4m nay t\u00f4i m\u1ec7t qu\u00e1, \u0111\u01b0\u1ee3c b\u1edbt v\u00e0i xu c\u0169ng th\u1ea5y vui."
      replyVariants: []
    ask:
      tomas: "Kh\u00e1ch n\u00e0o m\u00e0 qu\u00fd th\u1ebf h\u1ea3 b\u00e1c?"
      reply: "Qu\u00fd l\u1eafm, ch\u1eafc v\u1eady. \u00d4ng ch\u1ee7 b\u1eaft t\u00f4i d\u1ecdn l\u1ea1i {{ph\u00f2ng kh\u00e1ch t\u1ea7ng hai|F05}}, c\u0103n ph\u00f2ng kho\u00e1 t\u1eeb h\u1ed3i b\u00e0 ch\u1ee7 m\u1ea5t \u0111\u1ea5y. Lau c\u1ea3 bu\u1ed5i s\u00e1ng m\u00e0 ch\u01b0a xong."
      replyVariants: []
    press:
      tomas: "Ph\u00f2ng \u0111\u00f3ng c\u1eeda bao n\u0103m gi\u1edd m\u1edbi m\u1edf... ch\u1eafc kh\u00e1ch kh\u00f4ng ph\u1ea3i ng\u01b0\u1eddi l\u00e0ng m\u00ecnh b\u00e1c nh\u1ec9?"
      reply: "(h\u1ea1 gi\u1ecdng) C\u1eadu t\u00f2 m\u00f2 th\u1eadt \u0111\u1ea5y... Th\u00f4i, n\u00f3i nh\u1ecf c\u1eadu nghe: {{m\u1ed9t s\u0129 quan Lenmar s\u1eafp gh\u00e9|F06}}. \u0110\u1eebng k\u1ec3 v\u1edbi ai nh\u00e9, \u00f4ng ch\u1ee7 m\u00e0 bi\u1ebft l\u00e0 t\u00f4i m\u1ea5t vi\u1ec7c."
      replyVariants: []
    farewell:
      tomas: "B\u00e1c v\u1ec1 k\u1ebbo b\u1ebfp ch\u1edd \u1ea1."
      reply: "\u1eea, b\u1ebfp m\u00e0 thi\u1ebfu rau l\u00e0 \u00f4ng ch\u1ee7 l\u1ea1i m\u1eafng cho. Mai t\u00f4i gh\u00e9."
      replyVariants: []
    exit: "Perrin \u00f4m hai gi\u1ecf rau \u0111i v\u1ed9i v\u1ec1 ph\u00eda nh\u00e0 Vaule."
    exitVariants: []
  - customer: {fileID: 11400000, guid: 7c6e42a34471486bb790148cdbf172ec, type: 2}
    entrance: "Emel b\u01b0\u1edbc v\u00e0o, th\u00e1o g\u0103ng tay \u0111\u1eb7t l\u00ean qu\u1ea7y."
    entranceVariants: []
    greeting: "\u0110o\u00e0n xe t\u1edbi r\u1ed3i, \u0111\u1ed3n no \u0111\u1ee7 c\u1ea3. H\u00f4m nay t\u00f4i ch\u1ec9 gh\u00e9 mua ch\u00fat rau th\u01a1m th\u00f4i."
    greetingVariants:
    - condition: 1
      param: "F02"
      text: "\u0110\u00eam qua \u0111o\u00e0n xe b\u1ecb ch\u1eb7n ngay \u1edf c\u1ea7u B\u1eafc. C\u1ea3 \u0111\u1ed3n b\u1ecb khi\u1ec3n tr\u00e1ch m\u1ed9t tr\u1eadn. Cho t\u00f4i hai b\u00f3, h\u00f4m nay ch\u1eb3ng ai mu\u1ed1n \u0103n u\u1ed1ng g\u00ec."
    askCost: 0
    sellPrice: 10
    discountPrice: 4
    sellQuantity: 1
    discountQuantity: 1
    discountActionLabel: ""
    pressSuspicion: 1
    sell:
      tomas: "Rau th\u01a1m s\u00e1ng nay c\u00f2n t\u01b0\u01a1i l\u1eafm ch\u1ecb."
      reply: "\u0110\u01b0\u1ee3c. \u00cdt ra trong c\u00e1i l\u00e0ng n\u00e0y v\u1eabn c\u00f2n m\u1ed9t th\u1ee9 kh\u00f4ng l\u00e0m t\u00f4i \u0111au \u0111\u1ea7u."
      replyVariants: []
    discount:
      tomas: "H\u00f4m nay em l\u1ea5y ch\u1ecb gi\u00e1 v\u1ed1n th\u00f4i."
      reply: "C\u1eadu t\u1eed t\u1ebf qu\u00e1 nh\u1ec9. Hay l\u00e0 c\u1eadu c\u00f3 chuy\u1ec7n g\u00ec mu\u1ed1n nh\u1edd t\u00f4i?"
      replyVariants: []
    ask:
      tomas: "\u0110\u00eam qua tr\u00ean \u0111\u1ed3n c\u00f3 chuy\u1ec7n g\u00ec kh\u00f4ng ch\u1ecb?"
      reply: "\u0110\u1ea1i \u00fay Doran b\u1eaft l\u00ednh t\u00f4i ng\u1ed3i r\u00ecnh \u1edf kho th\u00f3c ph\u00eda T\u00e2y su\u1ed1t \u0111\u00eam. Ch\u1eb3ng ma n\u00e0o t\u1edbi. {{C\u00e1i b\u1eaby \u1ea5y gi\u0103ng s\u1eb5n t\u1eeb \u0111\u1ea7u tu\u1ea7n|F04}} m\u00e0 r\u1ed1t cu\u1ed9c v\u00f4 \u00edch."
      replyVariants:
      - condition: 1
        param: "F03"
        text: "\u00cdt ra \u0111\u00eam qua c\u0169ng t\u00f3m \u0111\u01b0\u1ee3c hai \u0111\u1ee9a Straka \u1edf kho th\u00f3c ph\u00eda T\u00e2y. \u0110\u1ea1i \u00fay Doran b\u1ea3o {{kho th\u00f3c l\u00e0 c\u00e1i b\u1eaby gi\u0103ng s\u1eb5n t\u1eeb \u0111\u1ea7u tu\u1ea7n|F04}}, ch\u1ec9 ch\u1edd c\u00f3 ng\u01b0\u1eddi m\u1eafc v\u00e0o."
    press:
      tomas: "\u0110\u00e3 bi\u1ebft ai b\u00e1o tin v\u1ee5 c\u1ea7u B\u1eafc ch\u01b0a ch\u1ecb?"
      reply: "C\u1eadu h\u1ecfi k\u1ef9 th\u1ebf l\u00e0m g\u00ec? \u1ede \u0111\u00e2y ch\u1eb3ng ai b\u00e1o tin g\u00ec c\u1ea3."
      replyVariants:
      - condition: 1
        param: "F02"
        text: "Ch\u01b0a. Nh\u01b0ng ng\u01b0\u1eddi bi\u1ebft gi\u1edd xe ch\u1ea1y \u0111\u00e2u c\u00f3 nhi\u1ec1u. T\u00f4i \u0111ang nh\u1edb l\u1ea1i xem h\u00f4m qua m\u00ecnh \u0111\u00e3 l\u1ee1 mi\u1ec7ng v\u1edbi nh\u1eefng ai..."
    farewell:
      tomas: "Ch\u1ecb gi\u1eef s\u1ee9c kh\u1ecfe \u1ea1."
      reply: "C\u1eadu c\u0169ng th\u1ebf. T\u1ed1i \u0111\u1eebng ra \u0111\u01b0\u1eddng."
      replyVariants: []
    exit: "Emel c\u1ea7m b\u00f3 rau th\u01a1m, \u0111\u1ee9ng l\u1eb7ng \u1edf c\u1eeda m\u1ed9t l\u00fac r\u1ed3i m\u1edbi \u0111i."
    exitVariants: []
  night:
