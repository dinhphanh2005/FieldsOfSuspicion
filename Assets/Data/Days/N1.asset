  visits:
  - customer: {fileID: 11400000, guid: 7c6e42a34471486bb790148cdbf172ec, type: 2}
    entrance: "C\u1eeda ti\u1ec7m m\u1edf. M\u1ed9t n\u1eef s\u0129 quan m\u1eb7c qu\u00e2n ph\u1ee5c Lenmar b\u01b0\u1edbc v\u00e0o, \u0111\u01b0a m\u1eaft nh\u00ecn m\u1ea5y k\u1ec7 rau c\u00f2n th\u01b0a."
    entranceVariants: []
    greeting: "C\u1eadu l\u00e0 ng\u01b0\u1eddi m\u1edbi thu\u00ea nh\u00e0 b\u00e0 Mabry \u0111\u1ea5y \u00e0? T\u00f4i l\u00e0 Emel, trung \u00fay tr\u00ean \u0111\u1ed3n. T\u1eeb nay ch\u1eafc t\u00f4i s\u1ebd hay gh\u00e9 \u0111\u00e2y mua rau cho b\u1ebfp \u0103n c\u1ee7a l\u00ednh."
    greetingVariants: []
    askCost: 0
    sellPrice: 10
    discountPrice: 6
    sellQuantity: 2
    discountQuantity: 2
    discountActionLabel: ""
    pressSuspicion: 1
    sell:
      tomas: "D\u1ea1, c\u00e0 r\u1ed1t s\u00e1ng nay em m\u1edbi nh\u1ed5. Ch\u1ecb l\u1ea5y bao nhi\u00eau c\u0169ng c\u00f3."
      reply: "Cho t\u00f4i hai b\u00f3. L\u00ednh \u0111\u1ed3n \u0103n kh\u1ecfe l\u1eafm, tu\u1ea7n n\u00e0y l\u1ea1i c\u00f2n ph\u1ea3i ch\u1edd {{\u0111o\u00e0n xe qu\u00e2n nhu|F01}} m\u00e3i ch\u01b0a th\u1ea5y \u0111\u00e2u."
      replyVariants: []
    discount:
      tomas: "Ch\u1ecb l\u00e0 kh\u00e1ch \u0111\u1ea7u ti\u00ean, em b\u1edbt cho ch\u1ecb ch\u00fat."
      reply: "C\u1eadu bi\u1ebft l\u00e0m \u0103n \u0111\u1ea5y. Nh\u01b0ng \u0111\u1eebng b\u1edbt cho ai c\u0169ng th\u1ebf nh\u00e9, b\u00e0 Mabry kh\u00f4ng nh\u1eadn ti\u1ec1n nh\u00e0 b\u1eb1ng c\u00e0 r\u1ed1t \u0111\u00e2u."
      replyVariants: []
    ask:
      tomas: "D\u1ea1o n\u00e0y em th\u1ea5y tr\u00ean \u0111\u1ed3n \u0111\u00f4ng ng\u01b0\u1eddi h\u1eb3n, ch\u1ecb nh\u1ec9?"
      reply: "\u0110\u00f4ng h\u01a1n, m\u00e0 c\u0169ng \u0111\u00f3i h\u01a1n. \u0110\u1ed3n \u0111ang ch\u1edd {{\u0111o\u00e0n xe qu\u00e2n nhu|F01}}, xe ch\u01b0a t\u1edbi th\u00ec t\u00f4i ph\u1ea3i \u0111i mua t\u1eebng b\u00f3 rau th\u1ebf n\u00e0y \u0111\u00e2y."
      replyVariants: []
    press:
      tomas: "Xe ch\u1edf g\u00ec m\u00e0 c\u1ea3 \u0111\u1ed3n ph\u1ea3i ng\u00f3ng th\u1ebf ch\u1ecb?"
      reply: "C\u1eadu h\u1ecfi k\u1ef9 th\u1ebf l\u00e0m g\u00ec? Rau c\u1ee7a c\u1eadu th\u00ec t\u00f4i quan t\u00e2m, c\u00f2n xe c\u1ee7a \u0111\u1ed3n th\u00ec c\u1eadu kh\u1ecfi ph\u1ea3i lo."
      replyVariants: []
    farewell:
      tomas: "Ch\u1ecb \u0111i thong th\u1ea3 \u1ea1."
      reply: "\u1eea. Mai t\u00f4i l\u1ea1i gh\u00e9."
      replyVariants: []
    exit: "Emel k\u1eb9p b\u00f3 rau d\u01b0\u1edbi tay, b\u01b0\u1edbc ra ph\u1ed1. Ti\u1ebfng gi\u00e0y \u0111inh xa d\u1ea7n v\u1ec1 ph\u00eda \u0111\u1ed3n."
    exitVariants: []
  night: []
