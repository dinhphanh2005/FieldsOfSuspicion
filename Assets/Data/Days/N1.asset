  visits:
  - customer: {fileID: 11400000, guid: 7c6e42a34471486bb790148cdbf172ec, type: 2}
    requiredMomentum: 0
    entrance: "Chu\u00f4ng c\u1eeda leng keng. M\u1ed9t n\u1eef s\u0129 quan tr\u1ebb, qu\u00e2n ph\u1ee5c Lenmar l\u00e0 ph\u1eb3ng phiu, b\u01b0\u1edbc v\u00e0o v\u00e0 nh\u00ecn quanh ti\u1ec7m m\u1ed9t l\u01b0\u1ee3t."
    entranceVariants: []
    greeting: "C\u1eadu l\u00e0 ng\u01b0\u1eddi m\u1edbi thu\u00ea nh\u00e0 b\u00e0 Mabry \u0111\u1ea5y \u00e0? T\u00f4i l\u00e0 Emel, trung \u00fay \u1edf \u0111\u1ed3n. T\u1eeb gi\u1edd t\u00f4i s\u1ebd gh\u00e9 mua rau cho b\u1ebfp \u0103n c\u1ee7a l\u00ednh."
    greetingVariants: []
    askCost: 0
    sellPrice: 7
    discountPrice: 4
    sellQuantity: 1
    discountQuantity: 1
    discountActionLabel: ""
    discountAccepted: 1
    pressSuspicion: 1
    sell:
      tomas: "C\u00e0 r\u1ed1t s\u00e1ng nay m\u1edbi nh\u1ed5, ch\u1ecb l\u1ea5y bao nhi\u00eau c\u0169ng c\u00f3 \u1ea1."
      reply: "Cho t\u00f4i m\u1ed9t b\u00f3 tr\u01b0\u1edbc \u0111\u00e3. L\u00ednh \u0111\u1ed3n \u0103n kh\u1ecfe l\u1eafm."
      replyVariants: []
    discount:
      tomas: "Kh\u00e1ch \u0111\u1ea7u ti\u00ean, em b\u1edbt cho ch\u1ecb m\u1ed9t ch\u00fat."
      reply: "C\u1eadu bi\u1ebft l\u00e0m \u0103n \u0111\u1ea5y. Nh\u01b0ng \u0111\u1eebng b\u1edbt cho ai c\u0169ng th\u1ebf, b\u00e0 Mabry kh\u00f4ng nh\u1eadn ti\u1ec1n nh\u00e0 b\u1eb1ng c\u00e0 r\u1ed1t \u0111\u00e2u."
      replyVariants: []
    ask:
      tomas: "\u0110\u1ed3n m\u00ecnh d\u1ea1o n\u00e0y \u0111\u00f4ng ng\u01b0\u1eddi h\u01a1n h\u1ea3 ch\u1ecb?"
      reply: "\u0110\u00f4ng h\u01a1n v\u00e0 \u0111\u00f3i h\u01a1n. \u0110\u1ed3n \u0111ang ch\u1edd {{\u0111o\u00e0n xe qu\u00e2n nhu|K01}}, xe ch\u01b0a t\u1edbi th\u00ec t\u00f4i ph\u1ea3i t\u1ef1 \u0111i mua t\u1eebng b\u00f3 rau th\u1ebf n\u00e0y."
      replyVariants: []
    press:
      tomas: "Xe ch\u1edf nh\u1eefng g\u00ec th\u1ebf ch\u1ecb?"
      reply: "Xe ch\u1edf g\u00ec th\u00ec li\u00ean quan g\u00ec t\u1edbi c\u1eadu? Rau c\u1ee7a c\u1eadu th\u00ec t\u00f4i quan t\u00e2m, c\u00f2n xe c\u1ee7a \u0111\u1ed3n th\u00ec c\u1eadu kh\u1ecfi lo."
      replyVariants: []
    farewell:
      tomas: "Ch\u1ecb \u0111i thong th\u1ea3 \u1ea1."
      reply: "Mai t\u00f4i l\u1ea1i gh\u00e9."
      replyVariants: []
    exit: "Emel k\u1eb9p b\u00f3 rau d\u01b0\u1edbi n\u00e1ch, \u0111i th\u1eb3ng v\u1ec1 ph\u00eda \u0111\u1ed3n m\u00e0 kh\u00f4ng ngo\u00e1i l\u1ea1i."
    exitVariants: []
  night:
  - a: home
    b: river
    risk: 0
    closed: 0
    hiddenUntil: ""
    note: "\u0110\u00eam \u0111\u1ea7u ti\u00ean. \u0110\u01b0\u1eddng ven s\u00f4ng v\u1eafng tanh, an to\u00e0n."
