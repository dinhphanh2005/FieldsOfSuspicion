  visits:
  - customer: {fileID: 11400000, guid: f3cb2fa764fb435a9453a16dbccbafb6, type: 2}
    entrance: "Perrin h\u1edbt h\u1ea3i b\u01b0\u1edbc v\u00e0o, \u1ed1ng qu\u1ea7n l\u1ea5m b\u00f9n v\u00ec ph\u1ea3i l\u1ed9i v\u00f2ng qua ch\u1ee3."
    entranceVariants: []
    greeting: "L\u1ea1i l\u00e0 t\u00f4i \u0111\u00e2y. B\u1ebfp b\u1ea3o thi\u1ebfu h\u00e0nh, thi\u1ebfu c\u00e0 r\u1ed1t, thi\u1ebfu \u0111\u1ee7 th\u1ee9 c\u1ea3."
    greetingVariants: []
    askCost: 0
    sellPrice: 20
    discountPrice: 12
    sellQuantity: 2
    discountQuantity: 2
    discountActionLabel: ""
    pressSuspicion: 1
    sell:
      tomas: "B\u00e1c l\u1ea5y nh\u01b0 h\u00f4m qua nh\u00e9?"
      reply: "G\u1ea5p \u0111\u00f4i h\u00f4m qua c\u01a1. Kh\u00e1ch s\u1eafp t\u1edbi n\u01a1i r\u1ed3i."
      replyVariants: []
    discount:
      tomas: "B\u00e1c gh\u00e9 nhi\u1ec1u, ch\u00e1u b\u1edbt cho b\u00e1c."
      reply: "C\u1eadu \u0111\u00fang l\u00e0 ng\u01b0\u1eddi t\u1ed1t. Coi nh\u01b0 t\u00f4i tr\u1ea3 \u01a1n: \u00f4ng ch\u1ee7 b\u1ea3o ph\u1ea3i xong h\u1ebft {{tr\u01b0\u1edbc t\u1ed1i th\u1ee9 N\u0103m|F07}}. T\u1ee9c l\u00e0 mai \u0111\u1ea5y, c\u1eadu xem c\u00f3 cu\u1ed1ng kh\u00f4ng."
      replyVariants: []
    ask:
      tomas: "Kh\u00e1ch s\u1eafp t\u1edbi ch\u01b0a h\u1ea3 b\u00e1c?"
      reply: "S\u1eafp r\u1ed3i. Nghe \u0111\u00e2u l\u00e0 {{m\u1ed9t s\u0129 quan Lenmar|F06}}, m\u00e0 \u00f4ng ch\u1ee7 ch\u1eb3ng n\u00f3i v\u1edbi t\u00f4i ng\u00e0y gi\u1edd g\u00ec c\u1ea3."
      replyVariants: []
    press:
      tomas: "Nh\u00ecn b\u1ebfp chu\u1ea9n b\u1ecb th\u1ebf, b\u00e1c \u0111o\u00e1n kh\u00e1ch t\u1edbi h\u00f4m n\u00e0o?"
      reply: "C\u1eadu t\u00f2 m\u00f2 th\u1eadt \u0111\u1ea5y... Nh\u01b0ng nh\u00ecn c\u00e1i ki\u1ec3u b\u1ebfp n\u00f3 cu\u1ed1ng l\u00ean th\u1ebf kia th\u00ec ch\u1eafc l\u00e0 {{t\u1ed1i th\u1ee9 N\u0103m|F07}}."
      replyVariants: []
    farewell:
      tomas: "B\u00e1c v\u1ec1 c\u1ea9n th\u1eadn, \u0111\u01b0\u1eddng ven s\u00f4ng ng\u1eadp \u0111\u1ea5y \u1ea1."
      reply: "Bi\u1ebft r\u1ed3i. L\u1ea1i ph\u1ea3i l\u1ed9i v\u00f2ng qua ch\u1ee3, kh\u1ed5 c\u00e1i ch\u00e2n t\u00f4i."
      replyVariants: []
    exit: "Perrin \u00f4m gi\u1ecf rau, l\u1ea7m b\u1ea7m than \u0111\u01b0\u1eddng l\u1ed9i r\u1ed3i khu\u1ea5t sau d\u00e3y nh\u00e0."
    exitVariants: []
  - customer: {fileID: 11400000, guid: 98d534f261fe4af994e75aef739a4b3a, type: 2}
    entrance: "Sable l\u00e1ch v\u00e0o, kh\u00e9p c\u1eeda sau l\u01b0ng l\u1ea1i, gi\u1ecdng nh\u1ecf h\u01a1n m\u1ecdi khi."
    entranceVariants: []
    greeting: "Anh n\u00f4ng d\u00e2n! H\u00f4m nay t\u00f4i c\u00f3 m\u1ed9t tin h\u01a1i n\u1eb7ng \u0111\u1ea5y."
    greetingVariants: []
    askCost: 5
    sellPrice: 0
    discountPrice: 0
    sellQuantity: 0
    discountQuantity: 0
    discountActionLabel: Đổi lời hứa lấy tin
    pressSuspicion: 1
    sell:
      tomas: "C\u00f4 c\u00f3 mua rau kh\u00f4ng?"
      reply: "Kh\u00f4ng. Nh\u01b0ng anh th\u00ec n\u00ean mua tin c\u1ee7a t\u00f4i."
      replyVariants: []
    discount:
      tomas: "H\u00f4m nay c\u00f4 mu\u1ed1n g\u00ec t\u00f4i c\u0169ng b\u1edbt n\u1eeda gi\u00e1."
      reply: "Th\u1ebf th\u00ec t\u00f4i n\u00f3i anh nghe chuy\u1ec7n n\u00e0y, kh\u00f4ng l\u1ea5y ti\u1ec1n: t\u1eeb t\u1ed1i qua {{c\u1ea7u B\u1eafc c\u00f3 tr\u1ea1m g\u00e1c su\u1ed1t \u0111\u00eam|F08}}. Ai qua \u0111\u00f3 sau gi\u1edd gi\u1edbi nghi\u00eam l\u00e0 b\u1ecb gi\u1eef l\u1ea1i h\u1ebft."
      replyVariants: []
    ask:
      tomas: "Tin g\u00ec m\u00e0 n\u1eb7ng th\u1ebf?"
      reply: "N\u0103m xu. ...Ng\u01b0\u1eddi ta \u0111\u1ed3n {{c\u00f3 ng\u01b0\u1eddi ph\u00eda Straka \u0111ang b\u00e1n tin cho Lenmar|F09}}. L\u00e0 ai th\u00ec t\u00f4i kh\u00f4ng bi\u1ebft. Nh\u01b0ng n\u1ebfu t\u00f4i l\u00e0 anh, t\u00f4i s\u1ebd kh\u00f4ng tin h\u1ebft nh\u1eefng g\u00ec m\u00ecnh \u0111\u1ecdc \u0111\u01b0\u1ee3c \u0111\u00e2u."
      replyVariants: []
    press:
      tomas: "C\u00f4 nghe ai n\u00f3i chuy\u1ec7n \u0111\u00f3?"
      reply: "H\u00f4m nay anh h\u1ecfi c\u00f2n nhi\u1ec1u h\u01a1n c\u1ea3 l\u00ednh \u0111\u1ed3n \u0111\u1ea5y. Tin n\u00e0y t\u00f4i gi\u1eef ngu\u1ed3n, anh th\u00f4ng c\u1ea3m."
      replyVariants: []
    farewell:
      tomas: "H\u1eb9n c\u00f4 h\u00f4m kh\u00e1c."
      reply: "H\u00f4m kh\u00e1c th\u00ec tin s\u1ebd \u0111\u1eaft h\u01a1n \u0111\u1ea5y."
      replyVariants: []
    exit: "Sable k\u00e9o m\u0169 tr\u00f9m \u0111\u1ea7u xu\u1ed1ng th\u1ea5p r\u1ed3i \u0111i ra, kh\u00f4ng ngo\u1ea3nh l\u1ea1i."
    exitVariants: []
