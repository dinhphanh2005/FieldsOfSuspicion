  visits:
  - customer: {fileID: 11400000, guid: f3cb2fa764fb435a9453a16dbccbafb6, type: 2}
    requiredMomentum: 0
    entrance: "M\u1ed9t \u00f4ng l\u00e3o \u0111\u1ed9i m\u0169 n\u1ed3i, \u00e1o gi-l\u00ea \u0111\u00e3 s\u1eddn, r\u1ee5t r\u00e8 \u0111\u1ea9y c\u1eeda b\u01b0\u1edbc v\u00e0o."
    entranceVariants: []
    greeting: "Ch\u00e0o c\u1eadu. T\u00f4i l\u00e0 Perrin, qu\u1ea3n gia b\u00ean nh\u00e0 Vaule. B\u1ebfp nh\u00e0 t\u00f4i c\u1ea7n rau s\u1ea1ch, m\u00e0 ngo\u00e0i ch\u1ee3 to\u00e0n rau h\u00e9o c\u1ea3."
    greetingVariants: []
    askCost: 0
    sellPrice: 7
    discountPrice: 4
    sellQuantity: 1
    discountQuantity: 1
    discountActionLabel: ""
    discountAccepted: 1
    pressSuspicion: 1
    sell:
      tomas: "D\u1ea1, b\u00e1c c\u1ee9 ch\u1ecdn tho\u1ea3i m\u00e1i."
      reply: "C\u00e0 r\u1ed1t \u0111\u1eb9p \u0111\u1ea5y. \u00d4ng ch\u1ee7 t\u00f4i kh\u00f3 t\u00ednh l\u1eafm, nh\u01b0ng th\u1ebf n\u00e0y ch\u1eafc kh\u00f4ng ch\u00ea \u0111\u01b0\u1ee3c."
      replyVariants: []
    discount:
      tomas: "L\u1ea7n \u0111\u1ea7u b\u00e1c gh\u00e9, ch\u00e1u b\u1edbt cho b\u00e1c."
      reply: "\u00d4i, c\u1eadu t\u1ed1t b\u1ee5ng qu\u00e1. Th\u1ebf th\u00ec t\u00f4i gh\u00e9 th\u01b0\u1eddng xuy\u00ean, nh\u00e0 t\u00f4i \u0103n nhi\u1ec1u rau l\u1eafm."
      replyVariants: []
    ask:
      tomas: "D\u1ea1o n\u00e0y b\u00ean nh\u00e0 Vaule c\u00f3 chuy\u1ec7n g\u00ec vui kh\u00f4ng b\u00e1c?"
      reply: "Vui th\u00ec ch\u1eb3ng th\u1ea5y. \u00d4ng ch\u1ee7 c\u1ee9 ng\u1ed3i m\u1ed9t m\u00ecnh trong th\u01b0 ph\u00f2ng. \u00c0, \u00f4ng d\u1eb7n t\u00f4i \u0111i ch\u1ee3 s\u1edbm, v\u00ec \u0111\u01b0\u1eddng c\u00e1i s\u1ebd k\u00edn xe l\u00ednh v\u00e0o {{s\u00e1ng th\u1ee9 Ba|K04}}, l\u00fac \u0111o\u00e0n xe g\u00ec \u0111\u00f3 c\u1ee7a \u0111\u1ed3n v\u1ec1 t\u1edbi n\u01a1i."
      replyVariants: []
    press:
      tomas: "\u00d4ng Vaule lo chuy\u1ec7n g\u00ec m\u00e0 ng\u1ed3i m\u1ed9t m\u00ecnh m\u00e3i th\u1ebf b\u00e1c?"
      reply: "Chuy\u1ec7n nh\u00e0 ch\u1ee7, ng\u01b0\u1eddi l\u00e0m nh\u01b0 t\u00f4i \u0111\u00e2u d\u00e1m k\u1ec3... Ch\u1ec9 bi\u1ebft t\u1eeb h\u1ed3i b\u00e0 ch\u1ee7 m\u1ea5t, \u00f4ng \u1ea5y hay vi\u1ebft th\u01b0 g\u1eedi l\u00ean \u0111\u1ed3n. Vi\u1ebft xong l\u1ea1i \u0111\u1ed1t b\u1ea3n nh\u00e1p, ch\u1eb3ng \u0111\u1ec3 l\u1ea1i t\u1edd n\u00e0o."
      replyVariants: []
    farewell:
      tomas: "H\u1eb9n b\u00e1c l\u1ea7n sau \u1ea1."
      reply: "\u1eea, mai m\u1ed1t t\u00f4i l\u1ea1i gh\u00e9."
      replyVariants: []
    exit: "Perrin x\u00e1ch gi\u1ecf rau, ch\u1eadm r\u00e3i \u0111i v\u1ec1 ph\u00eda ng\u00f4i nh\u00e0 l\u1edbn cu\u1ed1i l\u00e0ng."
    exitVariants: []
  - customer: {fileID: 11400000, guid: 7c6e42a34471486bb790148cdbf172ec, type: 2}
    requiredMomentum: 0
    entrance: "Emel b\u01b0\u1edbc v\u00e0o, v\u1ebb v\u1ed9i v\u00e3, m\u0169 c\u00f2n ch\u01b0a k\u1ecbp b\u1ecf xu\u1ed1ng."
    entranceVariants: []
    greeting: "L\u1ea1i l\u00e0 t\u00f4i \u0111\u00e2y. H\u00f4m nay t\u00f4i c\u1ea7n nhi\u1ec1u h\u01a1n, t\u1ed1i nay \u0111\u1ed3n b\u1eadn."
    greetingVariants: []
    askCost: 0
    sellPrice: 7
    discountPrice: 4
    sellQuantity: 2
    discountQuantity: 1
    discountActionLabel: ""
    discountAccepted: 1
    pressSuspicion: 1
    sell:
      tomas: "Ch\u1ecb l\u1ea5y m\u1ea5y b\u00f3 \u1ea1?"
      reply: "Hai b\u00f3. T\u1ed1i nay c\u1ea3 \u0111\u1ed3n \u0103n mu\u1ed9n."
      replyVariants: []
    discount:
      tomas: "Ch\u1ecb l\u1ea5y nhi\u1ec1u, em b\u1edbt cho ch\u1ecb."
      reply: "B\u1edbt cho t\u00f4i \u00e0? C\u1eadu \u0111\u1ecbnh l\u1ea5y l\u00f2ng l\u00ednh \u0111\u1ed3n \u0111\u1ea5y h\u1ea3? ...Th\u00f4i \u0111\u01b0\u1ee3c, coi nh\u01b0 t\u00f4i n\u1ee3 c\u1eadu. T\u1ed1i nay c\u1ea3 \u0111\u1ed9i ph\u1ea3i th\u1ee9c t\u1edbi {{n\u1eeda \u0111\u00eam|K03}}, c\u00f3 b\u00f3 rau ngon c\u0169ng \u0111\u1ee1."
      replyVariants: []
    ask:
      tomas: "T\u1ed1i nay \u0111\u1ed3n c\u00f3 vi\u1ec7c g\u00ec m\u00e0 b\u1eadn th\u1ebf ch\u1ecb?"
      reply: "C\u00e1i {{\u0111o\u00e0n xe qu\u00e2n nhu|K01}} cu\u1ed1i c\u00f9ng c\u0169ng t\u1edbi. Xe s\u1ebd \u0111i qua {{c\u1ea7u B\u1eafc|K02}} trong \u0111\u00eam nay, n\u00ean c\u1ea3 \u0111\u1ed9i ph\u1ea3i ra canh."
      replyVariants: []
    press:
      tomas: "Xe qua l\u00fac m\u1ea5y gi\u1edd h\u1ea3 ch\u1ecb?"
      reply: "Sao c\u1eadu l\u1ea1i mu\u1ed1n bi\u1ebft gi\u1edd xe ch\u1ea1y? ...T\u1edbi {{n\u1eeda \u0111\u00eam|K03}} l\u00e0 xong. Gi\u1edd th\u00ec c\u1eadu tr\u1ed3ng rau hay \u0111\u1ebfm xe \u0111\u1ea5y?"
      replyVariants: 
      - condition: 13
        param: "K03"
        text: "T\u00f4i v\u1eeba n\u00f3i r\u1ed3i c\u00f2n g\u00ec, t\u1edbi n\u1eeda \u0111\u00eam. C\u1eadu nh\u1edb gi\u1edd xe ch\u1ea1y k\u1ef9 th\u1ebf \u0111\u1ec3 l\u00e0m g\u00ec? C\u1eadu tr\u1ed3ng rau hay \u0111\u1ebfm xe \u0111\u1ea5y?"
    farewell:
      tomas: "Ch\u1ecb tr\u1ef1c \u0111\u00eam v\u1ea5t v\u1ea3 r\u1ed3i."
      reply: "\u1eea. C\u1ea7u cho \u0111\u00eam nay y\u00ean."
      replyVariants: []
    exit: "Emel \u0111\u1ed9i l\u1ea1i m\u0169, b\u01b0\u1edbc nhanh ra \u0111\u01b0\u1eddng c\u00e1i."
    exitVariants: []
  - customer: {fileID: 11400000, guid: 98d534f261fe4af994e75aef739a4b3a, type: 2}
    requiredMomentum: 0
    entrance: "M\u1ed9t c\u00f4 g\u00e1i \u0111eo g\u00f9i \u0111\u1ea7y kim ch\u1ec9, x\u00e0 ph\u00f2ng v\u00e0 nh\u1eefng th\u1ee9 kh\u00f4ng t\u00ean, t\u1ef1a v\u00e0o qu\u1ea7y nh\u01b0 th\u1ec3 \u0111\u00e3 quen ti\u1ec7m t\u1eeb l\u00e2u."
    entranceVariants: []
    greeting: "Ch\u00e0o anh n\u00f4ng d\u00e2n! T\u00f4i c\u00f3 kim ch\u1ec9, x\u00e0 ph\u00f2ng, v\u00e0 c\u1ea3 tin t\u1ee9c. Th\u1ee9 cu\u1ed1i c\u00f9ng th\u00ec \u0111\u1eaft h\u01a1n m\u1ed9t ch\u00fat."
    greetingVariants: []
    askCost: 5
    sellPrice: 7
    discountPrice: 4
    sellQuantity: 1
    discountQuantity: 1
    discountActionLabel: ""
    discountAccepted: 1
    pressSuspicion: 1
    sell:
      tomas: "C\u00f4 mua \u00edt c\u00e0 r\u1ed1t kh\u00f4ng?"
      reply: "T\u00f4i kh\u00f4ng \u0103n c\u00e0 r\u1ed1t, nh\u01b0ng mua m\u1ed9t b\u00f3 \u0111\u1ec3 l\u1ea5y l\u00f2ng anh v\u1eady."
      replyVariants: []
    discount:
      tomas: "T\u00f4i b\u1edbt cho c\u00f4 n\u1eeda gi\u00e1."
      reply: "Anh h\u00e0o ph\u00f3ng th\u1eadt. Chuy\u1ec7n n\u00e0y t\u00f4i k\u1ec3 kh\u00f4ng l\u1ea5y ti\u1ec1n: d\u1ea1o n\u00e0y \u0111\u1ed3n r\u00fat b\u1edbt l\u00ednh kh\u1ecfi m\u1ea5y ch\u1ed7 canh ngo\u00e0i l\u00e0ng. Ch\u1ed7 n\u00e0o th\u00ec ph\u1ea3i tr\u1ea3 ti\u1ec1n."
      replyVariants: []
    ask:
      tomas: "H\u00f4m nay c\u00f3 tin g\u00ec \u0111\u00e1ng ti\u1ec1n kh\u00f4ng?"
      reply: "N\u0103m xu. ...C\u1ea3m \u01a1n. Kho th\u00f3c ph\u00eda T\u00e2y \u0111ang {{b\u1ecf tr\u1ed1ng, kh\u00f4ng ai canh|K05}}. Ai mu\u1ed1n l\u1ea5y l\u1ea1i ch\u00fat th\u00f3c c\u1ee7a l\u00e0ng th\u00ec \u0111\u00e2y l\u00e0 l\u00fac."
      replyVariants: []
    press:
      tomas: "C\u00f4 nghe tin \u0111\u00f3 \u1edf \u0111\u00e2u?"
      reply: "Ng\u01b0\u1eddi b\u00e1n tin m\u00e0 khai ngu\u1ed3n th\u00ec c\u00f2n b\u00e1n \u0111\u01b0\u1ee3c cho ai n\u1eefa? Anh \u0111\u1ecbnh tranh m\u1ed1i c\u1ee7a t\u00f4i \u00e0?"
      replyVariants: []
    farewell:
      tomas: "C\u00f4 \u0111i c\u1ea9n th\u1eadn."
      reply: "T\u00f4i l\u00fac n\u00e0o c\u0169ng c\u1ea9n th\u1eadn. Anh m\u1edbi l\u00e0 ng\u01b0\u1eddi n\u00ean c\u1ea9n th\u1eadn."
      replyVariants: []
    exit: "Sable nh\u00e1y m\u1eaft, r\u1ed3i l\u1eabn v\u00e0o d\u00f2ng ng\u01b0\u1eddi ngo\u00e0i ch\u1ee3."
    exitVariants: []
