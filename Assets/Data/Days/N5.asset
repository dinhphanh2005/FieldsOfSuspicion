  visits:
  - customer: {fileID: 11400000, guid: 7c6e42a34471486bb790148cdbf172ec, type: 2}
    requiredMomentum: 0
    entrance: "Emel b\u01b0\u1edbc v\u00e0o, d\u1eebng l\u1ea1i l\u00e2u h\u01a1n th\u01b0\u1eddng l\u1ec7 \u1edf ng\u01b0\u1ee1ng c\u1eeda."
    entranceVariants: []
    greeting: "Ch\u00e0o c\u1eadu. H\u00f4m nay t\u00f4i \u0111\u01b0\u1ee3c ngh\u1ec9 n\u1eeda ng\u00e0y, mua \u00edt rau r\u1ed3i v\u1ec1 ng\u1ee7."
    greetingVariants: 
    - condition: 8
      param: ""
      text: "Tomas. L\u00ednh tu\u1ea7n n\u00f3i t\u1ed1i qua th\u1ea5y b\u00f3ng ng\u01b0\u1eddi \u0111i v\u1ec1 ph\u00eda nh\u00e0 c\u1eadu. T\u00f4i n\u00f3i tr\u01b0\u1edbc \u0111\u1ec3 c\u1eadu bi\u1ebft."
    - condition: 7
      param: ""
      text: "Ch\u00e0o c\u1eadu. D\u1ea1o n\u00e0y \u0111\u00eam n\u00e0o c\u0169ng c\u00f3 ng\u01b0\u1eddi \u0111i l\u1ea1i ngo\u00e0i \u0111\u01b0\u1eddng. C\u1eadu n\u00ean \u0111\u00f3ng c\u1eeda s\u1edbm."
    askCost: 0
    sellPrice: 7
    discountPrice: 0
    sellQuantity: 1
    discountQuantity: 1
    discountActionLabel: ""
    discountAccepted: 1
    pressSuspicion: 1
    sell:
      tomas: "Ch\u1ecb l\u1ea5y nh\u01b0 m\u1ecdi khi nh\u00e9?"
      reply: "\u1eea. Nh\u01b0 m\u1ecdi khi."
      replyVariants: []
    discount:
      tomas: "H\u00f4m nay em bi\u1ebfu ch\u1ecb m\u1ed9t b\u00f3."
      reply: "C\u1ea3m \u01a1n c\u1eadu."
      replyVariants: 
      - condition: 8
        param: ""
        text: "Bi\u1ebfu t\u00f4i? Ng\u01b0\u1eddi ta ch\u1ec9 bi\u1ebfu khi c\u00f3 chuy\u1ec7n c\u1ea7n gi\u1ea5u."
    ask:
      tomas: "\u0110\u1ed3n d\u1ea1o n\u00e0y c\u0103ng th\u1eb3ng ch\u1ecb nh\u1ec9?"
      reply: "T\u1eeb h\u00f4m th\u1ee9 Ba, \u0111\u1ea1i \u00fay cho l\u1eadp {{tr\u1ea1m g\u00e1c su\u1ed1t \u0111\u00eam|K13}} \u1edf c\u1ea7u B\u1eafc. Ai qua c\u1ea7u sau gi\u1edbi nghi\u00eam l\u00e0 b\u1ecb gi\u1eef l\u1ea1i h\u1ecfi chuy\u1ec7n ngay."
      replyVariants: []
    press:
      tomas: "T\u1ed1i nay \u0111\u1ea1i \u00fay c\u00f3 \u1edf \u0111\u1ed3n kh\u00f4ng ch\u1ecb?"
      reply: "C\u1eadu h\u1ecfi k\u1ef9 th\u1ebf l\u00e0m g\u00ec? T\u00f4i b\u1eaft \u0111\u1ea7u \u0111\u1ebfm s\u1ed1 c\u00e2u c\u1eadu h\u1ecfi r\u1ed3i \u0111\u1ea5y."
      replyVariants: []
    farewell:
      tomas: "Ch\u1ecb v\u1ec1 ngh\u1ec9 \u0111i."
      reply: "\u1eea, mai g\u1eb7p."
      replyVariants: 
      - condition: 8
        param: ""
        text: "T\u00f4i s\u1ebd v\u1ec1. C\u00f2n c\u1eadu th\u00ec t\u1ed1i nay \u1edf y\u00ean trong nh\u00e0 nh\u00e9."
    exit: "Emel \u0111i r\u1ed3i. Qua \u00f4 c\u1eeda, Tomas th\u1ea5y c\u00f4 d\u1eebng l\u1ea1i n\u00f3i g\u00ec \u0111\u00f3 v\u1edbi hai ng\u01b0\u1eddi l\u00ednh tu\u1ea7n."
    exitVariants: []
  - customer: {fileID: 11400000, guid: f3cb2fa764fb435a9453a16dbccbafb6, type: 2}
    requiredMomentum: 0
    entrance: "Perrin ch\u1ec9 l\u00f3 \u0111\u1ea7u v\u00e0o c\u1eeda, tay v\u1eabn n\u1eafm ch\u1eb7t then."
    entranceVariants: []
    greeting: "H\u00f4m nay l\u00e0 ng\u00e0y \u0111\u00f3 r\u1ed3i. T\u00f4i ch\u1ec9 gh\u00e9 l\u1ea5y rau r\u1ed3i v\u1ec1 ngay, b\u1ebfp \u0111ang lo\u1ea1n c\u1ea3 l\u00ean."
    greetingVariants: 
    - condition: 10
      param: "C3"
      text: "S\u00e1ng nay l\u00ednh g\u1ecdi t\u00f4i l\u00ean \u0111\u1ed3n h\u1ecfi \u0111\u1ee7 th\u1ee9. T\u00f4i ch\u1ec9 l\u1ea5y rau r\u1ed3i v\u1ec1 ngay."
    askCost: 0
    sellPrice: 7
    discountPrice: 4
    sellQuantity: 1
    discountQuantity: 1
    discountActionLabel: ""
    discountAccepted: 0
    pressSuspicion: 1
    sell:
      tomas: "Rau c\u1ee7a b\u00e1c \u0111\u00e2y, ch\u00e1u g\u00f3i s\u1eb5n r\u1ed3i."
      reply: "C\u1ea3m \u01a1n c\u1eadu. C\u1eadu chu \u0111\u00e1o h\u01a1n c\u1ea3 ng\u01b0\u1eddi nh\u00e0 t\u00f4i."
      replyVariants: []
    discount:
      tomas: "H\u00f4m nay ch\u00e1u l\u1ea5y b\u00e1c r\u1ebb th\u00f4i."
      reply: "Th\u00f4i, c\u1ee9 l\u1ea5y \u0111\u1ee7 ti\u1ec1n. H\u00f4m nay \u00f4ng ch\u1ee7 r\u1ed9ng tay l\u1eafm."
      replyVariants: []
    ask:
      tomas: "M\u1ecdi vi\u1ec7c \u1ed5n c\u1ea3 ch\u1ee9 b\u00e1c?"
      reply: "\u1ed4n... \u00d4ng ch\u1ee7 cho c\u1ea3 nh\u00e0 ngh\u1ec9 s\u1edbm, ch\u1ec9 gi\u1eef t\u00f4i l\u1ea1i \u0111\u1ec3 m\u1edf c\u1eeda. Kh\u00e1ch t\u1edbi {{sau gi\u1edd gi\u1edbi nghi\u00eam|K19}}, c\u1eadu tin kh\u00f4ng? Ng\u01b0\u1eddi th\u01b0\u1eddng m\u00e0 ra \u0111\u01b0\u1eddng gi\u1edd \u1ea5y l\u00e0 b\u1ecb b\u1eaft."
      replyVariants: []
    press:
      tomas: "Kh\u00e1ch \u0111i m\u1ed9t m\u00ecnh hay c\u00f3 l\u00ednh theo h\u1ea3 b\u00e1c?"
      reply: "C\u1eadu t\u00f2 m\u00f2 th\u1eadt \u0111\u1ea5y. T\u00f4i ch\u1ec9 l\u00e0 ng\u01b0\u1eddi m\u1edf c\u1eeda th\u00f4i."
      replyVariants: []
    farewell:
      tomas: "Ch\u00fac b\u00e1c t\u1ed1i nay \u00eam \u1ea3."
      reply: "C\u1ea7u \u0111\u01b0\u1ee3c nh\u01b0 c\u1eadu n\u00f3i."
      replyVariants: []
    exit: "Perrin v\u1ed9i v\u00e3 \u0111i, qu\u00ean c\u1ea3 l\u1ea5y ti\u1ec1n th\u1eeba."
    exitVariants: []
