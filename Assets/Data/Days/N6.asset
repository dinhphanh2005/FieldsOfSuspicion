  visits:
  - customer: {fileID: 11400000, guid: f3cb2fa764fb435a9453a16dbccbafb6, type: 2}
    requiredMomentum: 0
    entrance: "Perrin b\u01b0\u1edbc v\u00e0o, ch\u1eadm r\u00e3i h\u01a1n m\u1ecdi ng\u00e0y, m\u1eaft \u0111\u1ecf nh\u01b0 thi\u1ebfu ng\u1ee7."
    entranceVariants: []
    greeting: "Kh\u00e1ch \u0111i r\u1ed3i. \u00d4ng ch\u1ee7 vui l\u1eafm, th\u01b0\u1edfng cho t\u00f4i m\u1ed9t \u0111\u1ed3ng b\u1ea1c."
    greetingVariants: 
    - condition: 11
      param: "C3"
      text: "C\u1eadu nghe chuy\u1ec7n ch\u01b0a? Xe c\u1ee7a \u0111\u1ea1i \u00fay b\u1ecb ch\u1eb7n ngay tr\u00ean \u0111\u01b0\u1eddng t\u1eeb nh\u00e0 t\u00f4i v\u1ec1. L\u00ednh h\u1ecfi t\u00f4i c\u1ea3 bu\u1ed5i s\u00e1ng."
    askCost: 0
    sellPrice: 7
    discountPrice: 4
    sellQuantity: 1
    discountQuantity: 1
    discountActionLabel: ""
    discountAccepted: 1
    pressSuspicion: 1
    sell:
      tomas: "B\u00e1c l\u1ea5y \u00edt th\u00f4i nh\u1ec9, kh\u00e1ch v\u1ec1 r\u1ed3i."
      reply: "\u1eea, h\u00f4m nay nh\u00e0 v\u1eafng."
      replyVariants: []
    discount:
      tomas: "Ch\u00e1u b\u1edbt cho b\u00e1c, coi nh\u01b0 m\u1eebng b\u00e1c xong vi\u1ec7c."
      reply: "C\u1ea3m \u01a1n c\u1eadu. M\u1ea5y h\u00f4m nay t\u00f4i ch\u01b0a \u0111\u01b0\u1ee3c ng\u1ee7 ngon."
      replyVariants: []
    ask:
      tomas: "Kh\u00e1ch th\u1ebf n\u00e0o h\u1ea3 b\u00e1c?"
      reply: "L\u00fac d\u1ecdn ph\u00f2ng, t\u00f4i th\u1ea5y kh\u00e1ch \u0111\u1ec3 qu\u00ean chi\u1ebfc {{kh\u0103n tay th\u00eau h\u00ecnh chim b\u00e1ch thanh|K15}}. T\u00f4i c\u1ea5t \u0111i r\u1ed3i, kh\u00f4ng d\u00e1m \u0111\u1ee5ng v\u00e0o n\u1eefa."
      replyVariants: []
    press:
      tomas: "Kh\u00e1ch \u0111\u00f3 l\u00e0 ng\u01b0\u1eddi Lenmar \u00e0 b\u00e1c?"
      reply: "\u00d4ng ch\u1ee7 d\u1eb7n qu\u00ean h\u1ebft chuy\u1ec7n t\u1ed1i qua. T\u00f4i ch\u1ec9 nh\u1edb ng\u01b0\u1eddi \u1ea5y n\u00f3i gi\u1ecdng mi\u1ec1n bi\u00ean gi\u1edbi, gi\u1ed1ng ng\u01b0\u1eddi b\u00ean kia s\u00f4ng."
      replyVariants: []
    farewell:
      tomas: "B\u00e1c ngh\u1ec9 ng\u01a1i \u0111i."
      reply: "\u1eea. C\u1eadu c\u0169ng v\u1eady."
      replyVariants: []
    exit: "Perrin \u0111i, \u0111\u1ec3 l\u1ea1i tr\u00ean qu\u1ea7y m\u00f9i long n\u00e3o thoang tho\u1ea3ng."
    exitVariants: []
  - customer: {fileID: 11400000, guid: 98d534f261fe4af994e75aef739a4b3a, type: 2}
    requiredMomentum: 0
    entrance: "Sable ng\u1ed3i ph\u1ecbch xu\u1ed1ng chi\u1ebfc gh\u1ebf c\u1ea1nh qu\u1ea7y, m\u1eaft s\u00e1ng r\u1ee1."
    entranceVariants: []
    greeting: "Anh n\u00f4ng d\u00e2n, t\u1ed1i qua t\u00f4i v\u1ec1 mu\u1ed9n, th\u1ea5y m\u1ed9t chuy\u1ec7n hay l\u1eafm."
    greetingVariants: []
    askCost: 10
    sellPrice: 7
    discountPrice: 4
    sellQuantity: 1
    discountQuantity: 1
    discountActionLabel: ""
    discountAccepted: 1
    pressSuspicion: 1
    sell:
      tomas: "C\u00f4 mua rau kh\u00f4ng?"
      reply: "L\u1ea1i c\u00e0 r\u1ed1t. Th\u00f4i \u0111\u01b0\u1ee3c, m\u1ed9t b\u00f3."
      replyVariants: []
    discount:
      tomas: "T\u00f4i b\u1edbt cho c\u00f4, k\u1ec3 t\u00f4i nghe \u0111i."
      reply: "Anh b\u1edbt gi\u00e1 th\u00ec t\u00f4i t\u1eb7ng m\u1ed9t chuy\u1ec7n v\u1eb7t: l\u00f2 g\u1ea1ch \u1ea5y m\u00e0, \u00f4ng Sev hay d\u00e1n th\u00f4ng b\u00e1o l\u00ean b\u1ea3ng tin l\u00e0ng l\u1eafm. Ch\u1eef \u0111\u1eb9p ra ph\u1ebft. L\u1ea1 l\u00e0 m\u1ed9t \u00f4ng th\u1ee3 g\u1ea1ch l\u1ea1i vi\u1ebft ch\u1eef \u0111\u1eb9p th\u1ebf."
      replyVariants: []
    ask:
      tomas: "Chuy\u1ec7n g\u00ec th\u1ebf?"
      reply: "M\u01b0\u1eddi xu. T\u00f4i \u0111\u00e3 b\u1ea3o h\u00f4m kh\u00e1c tin s\u1ebd \u0111\u1eaft h\u01a1n m\u00e0. ...G\u1ea7n s\u00e1ng, c\u00f3 {{m\u1ed9t ng\u01b0\u1eddi tr\u00f9m \u00e1o \u0111i b\u1ed9 v\u1ec1 ph\u00eda l\u00f2 g\u1ea1ch|K16}}, t\u1eeb nh\u00e0 Vaule ra. Kh\u00f4ng l\u00ean xe c\u1ee7a \u0111\u1ea1i \u00fay, c\u1ee9 th\u1ebf \u0111i b\u1ed9, nh\u01b0 s\u1ee3 ai nh\u00ecn th\u1ea5y."
      replyVariants: []
    press:
      tomas: "C\u00f4 c\u00f3 nh\u00ecn r\u00f5 m\u1eb7t kh\u00f4ng?"
      reply: "Tr\u1eddi t\u1ed1i, t\u00f4i \u0111\u00e2u ph\u1ea3i m\u00e8o. Anh h\u1ecfi k\u1ef9 th\u1ebf, t\u00f4i l\u1ea1i b\u1eaft \u0111\u1ea7u t\u00f2 m\u00f2 v\u1ec1 anh r\u1ed3i \u0111\u1ea5y."
      replyVariants: []
    farewell:
      tomas: "C\u00f4 \u0111i \u0111\u01b0\u1eddng c\u1ea9n th\u1eadn."
      reply: "Mai ch\u1ee3 phi\u00ean. Anh nh\u1edb d\u1eady s\u1edbm."
      replyVariants: []
    exit: "Sable kho\u00e1c g\u00f9i l\u00ean vai, ng\u00e2n nga m\u1ed9t kh\u00fac h\u00e1t ch\u1ee3."
    exitVariants: []
