  visits:
  - customer: {fileID: 11400000, guid: 7c6e42a34471486bb790148cdbf172ec, type: 2}
    entrance: "Ti\u1ebfng ch\u1ee3 phi\u00ean \u1ed3n \u00e0o tr\u00e0n v\u00e0o khi Emel \u0111\u1ea9y c\u1eeda."
    entranceVariants: []
    greeting: "Ch\u1ee3 phi\u00ean \u0111\u00f4ng vui nh\u1ec9. Cho t\u00f4i \u00edt c\u00e0 r\u1ed1t, cu\u1ed1i tu\u1ea7n l\u00ednh \u0111\u01b0\u1ee3c \u0103n ngon m\u1ed9t b\u1eefa."
    greetingVariants:
    - condition: 8
      param: ""
      text: "C\u1eadu c\u1ee9 b\u00e1n h\u00e0ng \u0111i. T\u00f4i s\u1ebd \u0111\u1ee9ng \u0111\u00e2y xem m\u1ed9t l\u00fac."
    askCost: 0
    sellPrice: 20
    discountPrice: 12
    sellQuantity: -1
    discountQuantity: -1
    discountActionLabel: ""
    pressSuspicion: 2
    sell:
      tomas: "Ch\u1ecb l\u1ea5y bao nhi\u00eau \u1ea1?"
      reply: "L\u1ea5y h\u1ebft ch\u1ed7 n\u00e0y. C\u1eadu b\u00e1n cho t\u00f4i c\u1ea3 tu\u1ea7n r\u1ed3i, coi nh\u01b0 t\u00f4i c\u1ea3m \u01a1n."
      replyVariants: []
    discount:
      tomas: "H\u00f4m nay ch\u1ee3 phi\u00ean, em b\u1edbt cho ch\u1ecb."
      reply: "C\u1eadu \u0111\u00fang l\u00e0 ng\u01b0\u1eddi l\u00e0m \u0103n t\u1eed t\u1ebf."
      replyVariants:
      - condition: 8
        param: ""
        text: "T\u00f4i kh\u00f4ng c\u1ea7n c\u1eadu b\u1edbt. T\u00f4i c\u1ea7n c\u1eadu n\u00f3i th\u1eadt."
    ask:
      tomas: "Tu\u1ea7n n\u00e0y \u0111\u1ed3n m\u1ec7t l\u1eafm h\u1ea3 ch\u1ecb?"
      reply: "M\u1ec7t. \u0110\u1ea1i \u00fay b\u1eaft \u0111\u1ea7u \u0111\u1ed1i chi\u1ebfu danh s\u00e1ch nh\u1eefng ai ra \u0111\u01b0\u1eddng sau gi\u1edd gi\u1edbi nghi\u00eam c\u1ea3 tu\u1ea7n nay. T\u00f4i mong l\u00e0 kh\u00f4ng c\u00f3 t\u00ean c\u1eadu trong \u0111\u00f3."
      replyVariants: []
    press:
      tomas: "Danh s\u00e1ch \u0111\u00f3 c\u00f3 nh\u1eefng ai h\u1ea3 ch\u1ecb?"
      reply: "...\u0110\u00fang c\u00e1i c\u00e2u t\u00f4i kh\u00f4ng mu\u1ed1n nghe nh\u1ea5t t\u1eeb c\u1eadu \u0111\u1ea5y, Tomas."
      replyVariants: []
    farewell:
      tomas: "Ch\u00fac ch\u1ecb cu\u1ed1i tu\u1ea7n vui."
      reply: "C\u1eadu c\u0169ng v\u1eady, Tomas."
      replyVariants:
      - condition: 8
        param: ""
        text: "H\u1eb9n g\u1eb7p l\u1ea1i. S\u1edbm th\u00f4i."
    exit: "Emel l\u1eabn v\u00e0o \u0111\u00e1m \u0111\u00f4ng ngo\u00e0i ch\u1ee3."
    exitVariants:
    - condition: 8
      param: ""
      text: "Emel kh\u00f4ng \u0111i \u0111\u00e2u xa. C\u00f4 \u0111\u1ee9ng \u1edf g\u00f3c ch\u1ee3, m\u1eaft v\u1eabn nh\u00ecn v\u1ec1 ph\u00eda ti\u1ec7m."
